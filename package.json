{
  "name": "vite-plugin-version-stamp",
  "type": "module",
  "version": "1.0.4",
  "packageManager": "pnpm@10.28.0",
  "description": "_description_",
  "author": "Croatia Lu <wuli.croatia@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/croatialu",
  "homepage": "https://github.com/croatialu/vite-plugin-version-stamp#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croatialu/vite-plugin-version-stamp.git"
  },
  "bugs": "https://github.com/croatialu/vite-plugin-version-stamp/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "prepublishOnly": "nr build",
    "release": "bumpp && npm publish",
    "start": "esno src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.1",
    "@antfu/ni": "^28.2.0",
    "@antfu/utils": "^9.3.0",
    "@types/node": "^25.0.9",
    "bumpp": "^10.4.0",
    "eslint": "^9.39.2",
    "esno": "^4.8.0",
    "lint-staged": "^16.2.7",
    "pnpm": "^10.15.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
